    ]},
    {"source":"/__tfa/health","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/auth/v1/(.*)","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"},{"key":"Pragma","value":"no-cache"}]},
